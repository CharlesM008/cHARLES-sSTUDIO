# Copy to .env or set these in your hosting dashboard. Never commit real values.
PORT=3000
# First run only: creates the admin account (password: 10+ characters).
# If ADMIN_PASSWORD is not set, a random one is printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a long random string. Generated and stored in data/ if omitted.
SESSION_SECRET=
# Set to production when served over HTTPS (makes the admin cookie Secure-only).
NODE_ENV=production
# Behind a proxy/host such as Render, Railway or Nginx, set to true.
TRUST_PROXY=true
# Where the database and uploads live. Point this at a persistent disk on your host.
DATA_DIR=./data
